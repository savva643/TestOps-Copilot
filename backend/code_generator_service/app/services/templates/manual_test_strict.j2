"""Strict manual test case format (Приложение 1 style) in Allure TestOps as Code."""

import allure
import pytest
from allure_commons.types import AttachmentType


@allure.manual
@allure.label("owner", "{{ owner }}")
@allure.feature("{{ feature }}")
@allure.story("{{ story }}")
@allure.suite("{{ test_type }}")
@pytest.mark.manual
class ManualTestCasesStrict:
    """Generated manual test cases (strict format)."""

    @allure.title("{{ test_case_title }}")
    {% if jira_link %}
    @allure.link("{{ jira_link }}", name="jira")
    {% endif %}
    @allure.tag("{{ priority }}")
    @allure.label("priority", "{{ priority }}")
    def test_manual_case(self) -> None:
        """
        {{ test_case_description }}
        """
        # Arrange
        with allure.step("Arrange"):
            {% for step in arrange_steps %}
            with allure.step("{{ step }}"):
                pass
            {% endfor %}

        # Act
        with allure.step("Act"):
            {% for step in act_steps %}
            with allure.step("{{ step }}"):
                pass
            {% endfor %}

        # Assert
        with allure.step("Assert"):
            {% for step in assert_steps %}
            with allure.step("{{ step }}"):
                pass
            {% endfor %}

        allure.attach.file(
            "screenshots/registration_form.png",
            name="registration_form",
            attachment_type=AttachmentType.PNG,
        )

