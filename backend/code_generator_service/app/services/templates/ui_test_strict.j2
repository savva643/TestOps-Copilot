"""Strict UI test case format (Приложение 1 style) in Allure TestOps as Code."""

import allure
import pytest
from playwright.sync_api import Page, expect


@allure.label("owner", "{{ owner }}")
@allure.feature("{{ feature }}")
@allure.story("{{ story }}")
@allure.suite("ui")
class UITestsStrict:
    """Generated UI tests (strict format)."""

    @allure.title("{{ test_case_title }}")
    {% if jira_link %}
    @allure.link("{{ jira_link }}", name="jira")
    {% endif %}
    @allure.tag("{{ priority }}")
    @allure.label("priority", "{{ priority }}")
    def test_ui_scenario(self, page: Page) -> None:
        """
        {{ test_case_description }}
        """
        # Arrange
        base_url = "{{ specification.get('base_url', 'https://example.com') }}"
        with allure.step("Arrange: открыть страницу"):
            page.goto(base_url)

        # Act
        with allure.step("Act: взаимодействие с UI"):
            {% for step in act_steps %}
            with allure.step("{{ step }}"):
                pass
            {% endfor %}

        # Assert
        with allure.step("Assert: проверка состояния страницы"):
            screenshot = page.screenshot()
            allure.attach(
                screenshot,
                name="Page Screenshot",
                attachment_type=allure.attachment_type.PNG,
            )

