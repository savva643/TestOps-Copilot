"""UI test in Allure TestOps as Code format with AAA pattern."""

import allure
import pytest
from playwright.sync_api import Page, expect


@allure.label("owner", "{{ owner }}")
@allure.feature("{{ feature }}")
@allure.story("{{ story }}")
@allure.suite("ui")
class UITests:
    """Generated UI tests."""

    @allure.title("UI Test: {{ test_case[:50] }}...")
    {% if jira_link %}
    @allure.link("{{ jira_link }}", name="JIRA Ticket")
    {% endif %}
    @allure.tag("{{ priority }}")
    @allure.label("priority", "{{ priority }}")
    def test_ui_scenario(self, page: Page) -> None:
        """
        UI test following AAA pattern.
        
        {{ test_case }}
        """
        # Arrange
        base_url = "{{ specification.get('base_url', 'https://example.com') }}"

        with allure.step("Navigate to page"):
            page.goto(base_url)

        # Act
        with allure.step("Interact with UI elements"):
            # Example interactions
            # page.click("button#submit")
            # page.fill("input#username", "test_user")
            pass

        # Assert
        with allure.step("Verify page state"):
            # Example assertions
            # expect(page.locator("h1")).to_be_visible()
            screenshot = page.screenshot()
            allure.attach(
                screenshot,
                name="Page Screenshot",
                attachment_type=allure.attachment_type.PNG,
            )

