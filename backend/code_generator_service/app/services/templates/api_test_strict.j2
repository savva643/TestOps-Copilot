"""Strict API test case format (Приложение 1 style) in Allure TestOps as Code."""

import allure
import pytest
import httpx
from typing import Dict, Any


@allure.label("owner", "{{ owner }}")
@allure.feature("{{ feature }}")
@allure.story("{{ story }}")
@allure.suite("api")
class APITestsStrict:
    """Generated API tests (strict format)."""

    @allure.title("{{ test_case_title }}")
    {% if jira_link %}
    @allure.link("{{ jira_link }}", name="jira")
    {% endif %}
    @allure.tag("{{ priority }}")
    @allure.label("priority", "{{ priority }}")
    def test_api_endpoint(self) -> None:
        """
        {{ test_case_description }}
        """
        # Arrange
        base_url = "{{ specification.get('base_url', 'https://api.example.com') }}"
        endpoint = "{{ specification.get('endpoint', '/api/v1/endpoint') }}"
        headers = {
            "Content-Type": "application/json",
            "Authorization": "Bearer <token>",
        }
        payload: Dict[str, Any] = specification.get("payload", {})

        # Act
        with allure.step("Act: отправка запроса"):
            response = httpx.post(
                f"{base_url}{endpoint}",
                headers=headers,
                json=payload,
                timeout=30.0,
            )

        # Assert
        with allure.step("Assert: проверка статуса"):
            expected_status = specification.get("expected_status", 200)
            assert response.status_code == expected_status, f"Expected {expected_status}, got {response.status_code}"

        with allure.step("Assert: проверка тела ответа"):
            response_data = response.json()
            assert response_data is not None
            allure.attach(
                str(response_data),
                name="Response Body",
                attachment_type=allure.attachment_type.JSON,
            )

