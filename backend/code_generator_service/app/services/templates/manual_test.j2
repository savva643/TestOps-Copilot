"""Manual test case in Allure TestOps as Code format."""

import allure
import pytest
from allure_commons.types import AttachmentType


@allure.manual
@allure.label("owner", "{{ owner }}")
@allure.feature("{{ feature }}")
@allure.story("{{ story }}")
@allure.suite("{{ test_type }}")
@pytest.mark.manual
class ManualTestCases:
    """Generated manual test cases."""

    @allure.title("Test Case: {{ test_case[:50] }}...")
    {% if jira_link %}
    @allure.link("{{ jira_link }}", name="JIRA Ticket")
    {% endif %}
    @allure.tag("{{ priority }}")
    @allure.label("priority", "{{ priority }}")
    def test_manual_case(self) -> None:
        """
        Manual test case.
        
        {{ test_case }}
        """
        # Arrange
        with allure.step("Arrange: подготовка данных и окружения"):
            pass

        # Act
        with allure.step("Act: выполнение шагов теста"):
            pass

        # Assert
        with allure.step("Assert: проверка ожиданий и результатов"):
            allure.attach.file(
                "screenshots/test_screenshot.png",
                name="Test Screenshot",
                attachment_type=AttachmentType.PNG,
            )

